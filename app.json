{
  "expo": {
    "name": "Consultor Frontend",
    "slug": "consultor-frontend",
    "version": "1.0.0",
    "scheme": "consultor",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A2472"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.consultor.app"
    },
    "android": {
      "package": "com.consultor.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A2472"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "consultor"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "98d36fd0-6629-4360-a7dd-21814d4a5231"
      }
    }
  }
}
